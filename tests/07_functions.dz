// Test: function declaration, calls, return values
dalla add(a: tabi3i, b: tabi3i) -> tabi3i {
    raja3 a + b;
}

dalla greet(name: nass) -> fargh {
    ektb("salam %s!\n", name);
}

dalla square(n: tabi3i) -> tabi3i {
    raja3 n * n;
}

ektb("%lld\n", add(3, 7));
ektb("%lld\n", add(100, -50));
greet("brahim");
ektb("%lld\n", square(5));
ektb("%lld\n", add(square(3), square(4)));
